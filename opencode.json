{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "OPENCODE.md",
    "AGENTS.md"
  ],
  "server": {
    "port": 5173,
    "hostname": "127.0.0.1",
    "cors": [
      "http://localhost:5173"
    ]
  },
  "permission": {
    "*": "ask",
    "bash": {
      "npm run *": "allow",
      "npm.cmd *": "allow",
      "npx *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf *": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "build/**",
      ".react-router/**",
      ".git/**"
    ]
  }
}
